# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── Gemini TTS (required) ─────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Extra Gemini keys for rotation (optional) ─────────────────────────────────
GEMINI_API_KEY_1=your_second_gemini_key_here
GEMINI_API_KEY_2=your_third_gemini_key_here
GEMINI_API_KEY_3=your_fourth_gemini_key_here

# ── Pexels (optional, higher quality videos) ──────────────────────────────────
# Free at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# ── Facebook Auto-Publishing ───────────────────────────────────────────────────
# Setup guide:
#
# 1. Go to developers.facebook.com → Create App
# 2. Add "Facebook Login for Business" product
# 3. Go to your Facebook Page → Settings → Page Access Tokens
# 4. Generate token with permissions:
#      pages_manage_posts
#      pages_read_engagement
#      pages_show_list
# 5. Extend to 60-day long-lived token:
#    GET https://graph.facebook.com/v19.0/oauth/access_token
#        ?grant_type=fb_exchange_token
#        &client_id=YOUR_APP_ID
#        &client_secret=YOUR_APP_SECRET
#        &fb_exchange_token=YOUR_SHORT_TOKEN
#
# Your Page ID (numeric) — find at facebook.com/YOUR_PAGE/about
FB_PAGE_ID1=your_facebook_page_numeric_id

# Your Page Access Token (long-lived, 60 days)
FB_PAGE_TOKEN=your_long_lived_page_access_token
