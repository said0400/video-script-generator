# ══════════════════════════════════════════════════════════════════════════════
# 🔑 .env.example — Video Script Generator (2026 Edition)
# ══════════════════════════════════════════════════════════════════════════════
#
# 📋 Setup Instructions:
#   1. Copy this file:
#      cp .env.example .env
#
#   2. Fill in your real values below
#
#   3. NEVER commit .env to git
#
# 🆕 What's New (2026):
#   ✅ stable-ts replaces WhisperX (no HF_TOKEN needed!)
#   ✅ YouTube credentials per language
#   ✅ WhatsApp notifications (Green-API)
#   ✅ Long videos support
#
# ══════════════════════════════════════════════════════════════════════════════


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🤖 AI Services (Required)                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── Google Gemini (TTS + AI) ──────────────────────────────────────────────────
# Get keys: https://aistudio.google.com/app/apikey
# Supports up to 50 keys for auto-rotation on rate limits
# Recommended: 5+ keys for production

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# ... add up to GEMINI_API_KEY_50


# ── Groq (AI Enrichment) ──────────────────────────────────────────────────────
# Get keys: https://console.groq.com
# Supports up to 10 keys for rotation
# Recommended: 2+ keys

GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=
GROQ_API_KEY_2=


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📹 Stock Videos (Required)                           ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── Pixabay ───────────────────────────────────────────────────────────────────
# Get keys: https://pixabay.com/api/docs/
# Supports up to 10 keys for rotation

PIXABAY_API_KEY=your_pixabay_api_key_here
PIXABAY_API_KEY_1=
PIXABAY_API_KEY_2=


# ── Pexels (Higher quality, recommended) ─────────────────────────────────────
# Get keys: https://www.pexels.com/api/
# Supports up to 10 keys for rotation

PEXELS_API_KEY=your_pexels_api_key_here
PEXELS_API_KEY_1=
PEXELS_API_KEY_2=


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📘 Facebook Pages (3 Pages)                          ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# Setup Guide:
#   1. Go to developers.facebook.com → Create App
#   2. Add "Facebook Login for Business" product
#   3. Go to your Facebook Page → Settings → Page Access Tokens
#   4. Create token with these permissions:
#      • pages_manage_posts
#      • pages_read_engagement
#      • pages_show_list
#
#   5. Convert to long-lived token (60 days):
#      GET https://graph.facebook.com/v19.0/oauth/access_token
#          ?grant_type=fb_exchange_token
#          &client_id=YOUR_APP_ID
#          &client_secret=YOUR_APP_SECRET
#          &fb_exchange_token=YOUR_SHORT_TOKEN
#
#   6. Find Page ID at: facebook.com/YOUR_PAGE/about
#
# Optional (for auto-renewal):
#   FB_APP_ID and FB_APP_SECRET enable token extension
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Arabic Page ───────────────────────────────────────────────────────────────
FB_PAGE_ID_AR=your_arabic_page_numeric_id
FB_PAGE_TOKEN_AR=your_arabic_page_long_lived_token


# ── French Page ───────────────────────────────────────────────────────────────
FB_PAGE_ID_FR=your_french_page_numeric_id
FB_PAGE_TOKEN_FR=your_french_page_long_lived_token


# ── English Page ──────────────────────────────────────────────────────────────
FB_PAGE_ID_EN=your_english_page_numeric_id
FB_PAGE_TOKEN_EN=your_english_page_long_lived_token


# ── Facebook App (Optional — for token auto-renewal) ─────────────────────────
# Required only if you want to extend tokens programmatically

FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📺 YouTube Channels (3 Channels)                     ║
# ╚════════════════════════════════════════════════════════════════════════════╝
#
# Setup Guide:
#   1. Go to console.cloud.google.com
#   2. Create a new project (or select existing)
#   3. Enable "YouTube Data API v3"
#   4. Create OAuth 2.0 credentials:
#      Application type: Desktop app
#   5. Download credentials JSON
#   6. Use a tool to get refresh_token:
#      https://developers.google.com/oauthplayground
#      Scope: https://www.googleapis.com/auth/youtube.upload
#
#   7. Save:
#      • client_id     → YOUTUBE_CLIENT_ID_*
#      • client_secret → YOUTUBE_CLIENT_SECRET_*
#      • refresh_token → YOUTUBE_REFRESH_TOKEN_*
#
# ⚠️  Note: refresh_token does NOT expire (usually)
#           access_token is auto-refreshed by the system
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Arabic Channel ────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID_AR=your_youtube_client_id_for_arabic_channel
YOUTUBE_CLIENT_SECRET_AR=your_youtube_client_secret_for_arabic_channel
YOUTUBE_REFRESH_TOKEN_AR=your_youtube_refresh_token_for_arabic_channel


# ── French Channel ────────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID_FR=your_youtube_client_id_for_french_channel
YOUTUBE_CLIENT_SECRET_FR=your_youtube_client_secret_for_french_channel
YOUTUBE_REFRESH_TOKEN_FR=your_youtube_refresh_token_for_french_channel


# ── English Channel ───────────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID_EN=your_youtube_client_id_for_english_channel
YOUTUBE_CLIENT_SECRET_EN=your_youtube_client_secret_for_english_channel
YOUTUBE_REFRESH_TOKEN_EN=your_youtube_refresh_token_for_english_channel


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       📱 Notifications (Required)                          ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ── WhatsApp via Green-API ────────────────────────────────────────────────────
# Get account: https://console.green-api.com
# Free tier available (with limitations)
#
# Setup:
#   1. Create account at green-api.com
#   2. Create new Instance
#   3. Authorize WhatsApp by scanning QR code
#   4. Copy Instance ID and API Token

GREEN_API_INSTANCE_ID=your_green_api_instance_id
GREEN_API_TOKEN=your_green_api_token

# Phone number to receive notifications
# Format: country_code + number (no + or spaces)
# Example: 212786850913 (Morocco: 212 + 786850913)
WHATSAPP_PHONE_NUMBER=212786850913


# ── Telegram (Optional — Backup notifications) ───────────────────────────────
# Setup:
#   1. Open Telegram, search @BotFather
#   2. /newbot → follow instructions → get TOKEN
#   3. Get chat_id:
#      a. Send a message to your bot
#      b. Visit: https://api.telegram.org/botYOUR_TOKEN/getUpdates
#      c. Find "chat":{"id": YOUR_CHAT_ID}

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ══════════════════════════════════════════════════════════════════════════════
# 🔧 Variables NOT needed anymore (with stable-ts)
# ══════════════════════════════════════════════════════════════════════════════
#
# ❌ HF_TOKEN
#    No longer required — stable-ts has built-in alignment
#    (no pyannote.audio dependency)
#
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
# 📊 Quick Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# Required vs Optional:
#
#   ✅ REQUIRED:
#      - GEMINI_API_KEY      (TTS + AI)
#      - GROQ_API_KEY         (AI Enrichment)
#      - PEXELS_API_KEY       (Stock videos)
#      - PIXABAY_API_KEY      (Stock videos)
#      - FB_PAGE_ID_*         (Facebook)
#      - FB_PAGE_TOKEN_*      (Facebook)
#      - YOUTUBE_*_AR/FR/EN   (YouTube)
#      - GREEN_API_*          (WhatsApp notifications)
#      - WHATSAPP_PHONE_NUMBER
#
#   ⚪ OPTIONAL (recommended):
#      - Additional GEMINI/GROQ/PIXABAY/PEXELS keys (for rotation)
#      - FB_APP_ID + FB_APP_SECRET (for token auto-renewal)
#      - TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID (backup notifications)
#
#   ❌ NO LONGER NEEDED:
#      - HF_TOKEN (replaced by stable-ts)
#
# ══════════════════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════════════════
