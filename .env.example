# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ── Required: Gemini TTS ──────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Extra Gemini keys for rotation on quota exhaustion ──────────────
GEMINI_API_KEY_1=your_second_gemini_key_here
GEMINI_API_KEY_2=your_third_gemini_key_here
GEMINI_API_KEY_3=your_fourth_gemini_key_here

# ── Optional: Pexels (higher quality stock video) ─────────────────────────────
# Free at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here
