# ══════════════════════════════════════════════════════════════════════════════
# .env.example — Video Script Generator
# نسخ هذا الملف إلى .env وأضف قيمك الحقيقية
# cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════


# ── Gemini TTS + AI (مطلوب) ───────────────────────────────────────────────────
# احصل على مفاتيحك من: https://aistudio.google.com/app/apikey
# يدعم حتى 30 مفتاح للتدوير التلقائي عند rate limit

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_second_gemini_key_here
GEMINI_API_KEY_2=your_third_gemini_key_here
# ... أضف حتى GEMINI_API_KEY_29


# ── Groq (مطلوب) ──────────────────────────────────────────────────────────────
# احصل على مفتاحك من: https://console.groq.com
# يدعم مفتاحين للتدوير

GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=your_second_groq_key_here


# ── Pixabay (مطلوب) ───────────────────────────────────────────────────────────
# احصل على مفتاحك من: https://pixabay.com/api/docs/
# يدعم مفتاحين للتدوير

PIXABAY_API_KEY=your_pixabay_api_key_here
PIXABAY_API_KEY_1=your_second_pixabay_key_here


# ── Pexels (اختياري — جودة أعلى) ─────────────────────────────────────────────
# احصل على مفتاحك من: https://www.pexels.com/api/
# يدعم مفتاحين للتدوير

PEXELS_API_KEY=your_pexels_api_key_here
PEXELS_API_KEY_1=your_second_pexels_key_here


# ── HuggingFace (مطلوب لـ WhisperX alignment) ────────────────────────────────
# احصل على مفتاحك من: https://huggingface.co/settings/tokens
# مطلوب لتحميل نماذج pyannote.audio

HF_TOKEN=your_huggingface_token_here


# ── Facebook — الصفحة العربية ─────────────────────────────────────────────────
# دليل الإعداد:
# 1. اذهب إلى developers.facebook.com → أنشئ App
# 2. أضف "Facebook Login for Business"
# 3. اذهب إلى صفحتك على Facebook → Settings → Page Access Tokens
# 4. أنشئ token بالصلاحيات:
#      pages_manage_posts
#      pages_read_engagement
#      pages_show_list
# 5. حوّله إلى long-lived token (60 يوم):
#    GET https://graph.facebook.com/v19.0/oauth/access_token
#        ?grant_type=fb_exchange_token
#        &client_id=YOUR_APP_ID
#        &client_secret=YOUR_APP_SECRET
#        &fb_exchange_token=YOUR_SHORT_TOKEN
#
# رقم صفحتك (numeric ID) — تجده في facebook.com/YOUR_PAGE/about

FB_PAGE_ID_AR=your_arabic_page_numeric_id
FB_PAGE_TOKEN_AR=your_arabic_page_long_lived_token


# ── Facebook — الصفحة الفرنسية ───────────────────────────────────────────────

FB_PAGE_ID_FR=your_french_page_numeric_id
FB_PAGE_TOKEN_FR=your_french_page_long_lived_token


# ── Facebook — الصفحة الإنجليزية ─────────────────────────────────────────────

FB_PAGE_ID_EN=your_english_page_numeric_id
FB_PAGE_TOKEN_EN=your_english_page_long_lived_token
