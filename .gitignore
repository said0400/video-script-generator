# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — Video Script Generator
# ══════════════════════════════════════════════════════════════════════════════


# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local


# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
.python-version
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ── Database ──────────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3


# ── Audio / Video (ملفات مؤقتة) ──────────────────────────────────────────────
*.wav
*.mp3
*.ogg
*.aac
*.mp4
*.mov
*.webm
*.flac


# ── Images (مؤقتة) ────────────────────────────────────────────────────────────
*.png
*.jpg
*.jpeg
*.gif
*.webp


# ── Output ────────────────────────────────────────────────────────────────────
output/
output_*/
/tmp/vsg_*/


# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
remotion/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm


# ── Manifests مؤقتة ───────────────────────────────────────────────────────────
*_manifest.json


# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini


# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~


# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/


# ── Thumbnails HTML مؤقتة ─────────────────────────────────────────────────────
*_thumbnail.html


# ── WhisperX / HuggingFace cache (لا ترفعها) ─────────────────────────────────
.cache/


# ── ما يجب الاحتفاظ به ────────────────────────────────────────────────────────
# هذه الملفات يجب رفعها للمستودع:
!scripts/videos_ar.xlsx
!scripts/videos_fr.xlsx
!scripts/videos_en.xlsx
!assets/music/.gitkeep
!assets/videos/.gitkeep
!sfx/swoosh/.gitkeep
!sfx/whoosh/.gitkeep
!remotion/package-lock.json
