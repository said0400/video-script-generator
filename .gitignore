# ══════════════════════════════════════════════════════════════════════════════
# 🚫 .gitignore — Video Script Generator
# ══════════════════════════════════════════════════════════════════════════════
#
# Updated for:
#   ✅ stable-ts (replaced WhisperX)
#   ✅ Long videos support
#   ✅ Multi-format scripts
#   ✅ Notifications log
#
# ══════════════════════════════════════════════════════════════════════════════


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🔒 Secrets & Environment                             ║
# ╚════════════════════════════════════════════════════════════════════════════╝

.env
.env.local
.env.*.local
.envrc
*.env.bak

# Notification rate limit cache
.notify_rate_limit.json


# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                       🐍 Python                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Build artifacts
.Python
.python-version
pip-log.txt
pip-delete-this-directory.txt
.eggs/
*.egg-info/
*.egg
dist/
build/
develop-eggs/
downloads/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.manifest
*.spec

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
virtualenv/


